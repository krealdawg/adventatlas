{
  "_aide": "Configuration du robot de mise à jour. Voir GUIDE-MISE-EN-LIGNE.md, section « Mise à jour automatique ». Les valeurs ${NOM} sont lues dans les secrets GitHub.",
  "siteUrl": "https://krealdawg.github.io/adventatlas",
  "removeAfterDays": 2,
  "maxNewPerRun": 80,
  "checkProductPages": true,
  "keywords": [
    "calendrier de l'avent",
    "calendrier de l’avent",
    "calendrier avent",
    "adventskalender",
    "advent calendar",
    "advent-kalender",
    "calendario dell'avvento",
    "calendario avvento",
    "calendario de adviento",
    "adventkalender",
    "julekalender",
    "kalendarz adwentowy"
  ],
  "exclude": [
    "vide",
    "à remplir",
    "a remplir",
    "leer",
    "zum befüllen",
    "zum befuellen",
    "selbst befüllen",
    "empty",
    "fill your own",
    "refill",
    "diy kit",
    "support",
    "présentoir",
    "ständer",
    "stoffbeutel",
    "säckchen",
    "pochettes vides",
    "numéros autocollants",
    "zahlenaufkleber",
    "occasion",
    "gebraucht",
    "used"
  ],
  "feeds": [
    {
      "name": "Awin (Lookfantastic, Rituals, Douglas…) — un flux « Create-a-Feed » filtré sur les mots-clés",
      "enabled": false,
      "url": "${AWIN_FEED_URL}",
      "format": "csv",
      "fields": {
        "id": "aw_product_id",
        "title": "product_name",
        "brand": "brand_name",
        "price": "search_price",
        "currency": "currency",
        "link": "aw_deep_link",
        "productUrl": "merchant_deep_link",
        "inStock": "in_stock",
        "merchant": "merchant_name"
      }
    },
    {
      "name": "Galaxus via Tradedoubler — flux produits",
      "enabled": false,
      "url": "${TRADEDOUBLER_GALAXUS_FEED_URL}",
      "format": "csv",
      "fields": {
        "id": "TDProductId",
        "title": "name",
        "brand": "brand",
        "price": "price",
        "currency": "currency",
        "link": "productUrl",
        "productUrl": "",
        "inStock": "availability",
        "merchant": ""
      }
    },
    {
      "name": "Autre réseau (Effinity, Rakuten, CJ…) — flux JSON ou XML",
      "enabled": false,
      "url": "${OTHER_FEED_URL}",
      "format": "xml",
      "itemTag": "product",
      "fields": {
        "id": "id",
        "title": "title",
        "brand": "brand",
        "price": "price",
        "currency": "currency",
        "link": "link",
        "productUrl": "",
        "inStock": "availability",
        "merchant": "merchant"
      }
    }
  ],
